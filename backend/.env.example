# savvy-backend configuration
#
# Copy to .env (gitignored) and fill in. Nothing auto-loads it:
#
#   set -a && . ./.env && set +a && uv run uvicorn main:app --port 8000

# REQUIRED. Seals the stored EZLynx password (AES-256-GCM). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Lose it and every saved password becomes unreadable — which is the point.
SAVVY_ENC_KEY=

# --- camofox-browser ---
CAMOFOX_URL=http://localhost:9377
CAMOFOX_ACCESS_KEY=
# MCP server only. Leave unset for the backend: each agent then gets its own
# ezlynx-<username> profile (matching the Connections-page sign-in), so two
# agents' sessions never mix. Set only for a standalone stdio run signed in
# under a fixed profile name.
CAMOFOX_USER_ID=

# --- DeepSeek (OpenAI-compatible) ---
# REQUIRED for the chat page. It is the model that reads the operator's message
# and picks the EZLynx tools. Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- EZLynx ---
EZLYNX_BASE_URL=https://app.ezlynx.com

# --- storage ---
# SQLite file. Holds sealed passwords: keep it off shared disks and out of git.
SAVVY_DB=savvy.db

# --- mcp_server2.py ---
# Whose saved credentials and quotes this MCP server uses. One operator per server.
SAVVY_USER=default
# Where ezlynx-agent lives. Default is ../ezlynx-agent; it must be built
# (npm install && npm run build) before the quote tools work.
# EZLYNX_AGENT_DIR=
# A full Auto + Home run drives ~16 screens in a real browser.
EZLYNX_RUN_TIMEOUT_S=1800
# How far ahead a requote dates the new policy when the caller does not say.
EZLYNX_EFFECTIVE_LEAD_DAYS=30
# Tool calls the assistant may make in one turn before it gives up.
SAVVY_CHAT_ROUNDS=8
