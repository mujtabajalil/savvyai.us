# ezlynx-agent configuration
#
# Copy to .env (gitignored) and fill in. Nothing is auto-loaded: pass the file
# explicitly with Node's built-in flag, e.g.
#
#   node --env-file=.env dist/cli.js run --account 201601955 --quote ./quote.json
#
# This repo forbids the `dotenv` package (see CONTRIBUTING.md) — do not add it.

# --- camofox-browser server ---
CAMOFOX_URL=http://localhost:9377
CAMOFOX_ACCESS_KEY=
CAMOFOX_USER_ID=ezlynx-agent

# REQUIRED. EZLynx pages contain client PII and camofox ships crash telemetry by
# default. The agent refuses to start unless this is exactly "false".
CAMOFOX_CRASH_REPORT_ENABLED=false

# --- DeepSeek (OpenAI-compatible) ---
# Never commit a real key. Rotate immediately if one is ever shared.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Current model IDs (Sept 2026): deepseek-flash | deepseek-v4-pro
# The legacy deepseek-chat / deepseek-coder names are retired.
DEEPSEEK_MODEL=deepseek-flash

# --- EZLynx ---
EZLYNX_BASE_URL=https://app.ezlynx.com

# --- Safety ---
# Require an explicit "y" before submitting to carriers. Submission can trigger
# credit/underwriting reports. Only set false for unattended runs you trust.
REQUIRE_SUBMIT_CONFIRMATION=true

# --- Optional ---
# LOG_LEVEL=info              # debug | info | warn | error
# CAMOFOX_SESSION_KEY=default
# EZLYNX_DEBUG_ARTIFACTS=false  # screenshots/traces to ./debug (gitignored, contains PII)
# HTTP_TIMEOUT_MS=30000
